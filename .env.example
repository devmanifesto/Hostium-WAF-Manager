# Plantilla. No pongas secretos reales en este archivo ni en el repositorio.
# Hostium WAF Manager no lee credenciales desde aquí para publicar o desplegar.
# La auditoría SSH usa el agente o las claves ya configuradas en el sistema.

HOSTIUM_WAF_ROOT=
# Si vale 1, un fallo al descargar la imagen de integración hace fallar pytest
# en lugar de omitir la prueba.
HOSTIUM_REQUIRE_INTEGRATION=0
